{
  "name": "autosocial-backend",
  "version": "1.0.0",
  "description": "AutoSocial social media scheduling backend",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "predev": "tsc",
    "start": "node --env-file=.env dist/server.js",
    "dev": "concurrently -k -n tsc,node -c blue,green \"tsc --watch --preserveWatchOutput\" \"node --env-file=.env --watch dist/server.js\"",
    "typecheck": "tsc --noEmit",
    "seed": "pnpm build && node --env-file=.env dist/scripts/seed.js",
    "test": "tsc && node --experimental-test-module-mocks --test \"test/**/*.test.js\"",
    "migrate:encrypt-tokens": "tsc && node --env-file=.env dist/scripts/migrate-encrypt-tokens.js"
  },
  "dependencies": {
    "@agendajs/mongo-backend": "^4.0.3",
    "@aws-sdk/client-s3": "^3.1123.0",
    "@aws-sdk/s3-request-presigner": "^3.1123.0",
    "agenda": "^6.2.6",
    "better-auth": "^1.6.26",
    "better-auth-mongoose": "^0.1.1",
    "dayjs": "^1.11.10",
    "express": "^5.2.1",
    "file-type": "^22.0.2",
    "mime-types": "^3.0.2",
    "mongoose": "^9.9.4",
    "openai": "^7.8.0",
    "pino": "^10.3.1",
    "sharp": "^0.35.5",
    "twitter-api-v2": "^1.29.1",
    "zod": "^4.5.4"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "concurrently": "^10.0.5",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2"
  }
}
