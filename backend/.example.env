# Environment Variables
# Copy this file to .env and fill in your values

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=mongodb://localhost:27017/autosocial

# ─── Auth ─────────────────────────────────────────────────────────────────────

# ─── OpenAI (for AI post generation and image generation) ─────────────────────
OPENAI_API_KEY=sk-proj-your-openai-key-here
# Optional: override base URL for OpenAI-compatible APIs (Groq, Ollama, etc.)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# ─── Facebook / Instagram ─────────────────────────────────────────────────────
# Create an app at: https://developers.facebook.com/apps/
# Required permissions: pages_show_list, business_management, pages_manage_posts,
#   pages_manage_engagement, pages_read_engagement, read_insights,
#   instagram_basic, instagram_content_publish
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ─── X (Twitter) ─────────────────────────────────────────────────────────────
# Create an app at: https://developer.twitter.com/en/portal/dashboard
# Required access: Read and Write
# Auth type: OAuth 1.0a User Context
X_API_KEY=
X_API_SECRET=
# Optional: override callback URL (useful if X_CALLBACK differs from FRONTEND_URL)
# X_URL=https://your-app.com

# ─── LinkedIn ─────────────────────────────────────────────────────────────────
# Create an app at: https://www.linkedin.com/developers/apps/
# Required products: Share on LinkedIn, Sign In with LinkedIn using OpenID Connect,
#   Marketing Developer Platform (for company pages)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ─── S3 / Cloudflare R2 (for image uploads) ──────────────────────────────────
AWS_REGION=auto
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your-r2-access-key-id
AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# Optional: custom public URL (e.g. custom domain or r2.dev public URL)
# S3_PUBLIC_URL=https://pub-your-hash.r2.dev


BETTER_AUTH_URL=
BETTER_AUTH_SECRET=

# ─── Token Encryption (AES-256-GCM) ──────────────────────────────────────────
# 32-byte hex key for encrypting provider OAuth tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY= 
# Key version ID (increment when rotating keys)
TOKEN_ENCRYPTION_KEY_ID=v1